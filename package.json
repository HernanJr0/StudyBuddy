{
  "name": "studybuddy",
  "version": "0.1.0",
  "private": true,
  "description": "Estudo ativo com IA: transforma um PDF em resumo, flashcards e quiz. Roda inteiro no navegador, com a chave de API do próprio usuário.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "ts-fsrs": "^6.0.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.13",
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
